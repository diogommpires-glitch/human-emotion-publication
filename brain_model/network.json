     "targets": {"sensory_cortex": 1.0, "insula": 0.5, "hippocampus": 0.8, "amygdala_bla": 0.8, "amygdala_bla_reward": 0.6, "vmpfc": 0.5, "dacc": 0.6, "dlpfc": 0.7, "sensory_thalamus": 0.4},
