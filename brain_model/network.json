{
  "name": "Human Emotion spiking network",
  "version": 6,
  "status": "reduced_conductance_network_with_projected_neuromodulators",
  "description": "A reduced cell-level model of emotion circuits. Sensory channels arrive as Poisson spike trains at their anatomical entry points; adaptive spiking cells talk through delayed, short-term-depressing AMPA/NMDA/GABA-A/GABA-B synapses; dopamine, noradrenaline, serotonin, acetylcholine and oxytocin are released by their source nuclei in proportion to firing and diffuse to their target regions, where receptor occupancy changes excitability, adaptation and NMDA gain. Emotion readouts compare the stimulus period with the same run's pre-stimulus baseline. Region sizes, wiring strengths and receptor effects are literature-inspired priors, not a measured human connectome. Version 6 uses explicit contact-level plasticity and experimental dopamine occupancy gating, not reward prediction errors.",

  "plasticity": {
    "version": 1,
    "default_rule": "none",
    "rules": ["none", "pair_stdp", "dopamine_eligibility"],
    "A_plus": 0.001, "A_minus": 0.0012,
    "tau_plus_ms": 20.0, "tau_minus_ms": 20.0,
    "trace_tau_s": 1.0, "eta": 0.0001, "da_threshold": 0.05,
    "weight_bounds_relative_to_initial": [0.1, 2.0],
    "note": "Experimental contact-level learning. Dopamine is occupancy minus pre-stimulus baseline; this is not temporal-difference reward learning."
  },

  "runtime": {
    "time_step_ms": 1.0,
    "duration_seconds": 6.0,
    "baseline_window_seconds": [1.0, 2.5],
    "stimulus_seconds": [2.5, 5.0],
    "reference_duration_seconds": 2.5,
    "gpu_network_sizes": [16384, 65536, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216],
    "gpu_default_cells": 2097152,
    "cpu_network_sizes": [16384, 32768, 65536, 131072],
    "cpu_default_cells": 16384,
    "min_cells_per_region": 64,
    "raster_cells_per_region": 128,
    "topology_seed": 690125,
    "rate_smoothing_ms": 50,
    "record_every_ms": 10
  },

  "cell_types": {
    "regular_spiking":    {"v_rest_mV": -65, "v_reset_mV": -60, "v_threshold_mV": -50, "delta_t_mV": 2.0, "v_peak_mV": -30, "tau_m_ms": 20, "a": 0.13, "b_mV": 2.5, "tau_w_ms": 150, "refractory_ms": 2, "threshold_jitter_mV": 1.5, "release_u": 0.35, "recovery_ms": 450, "facilitation_ms": 0},
    "fast_spiking": {"v_rest_mV": -65, "v_reset_mV": -65, "v_threshold_mV": -52, "delta_t_mV": 0.5, "v_peak_mV": -30, "tau_m_ms": 10, "a": 0.0,  "b_mV": 0.0, "tau_w_ms": 100, "refractory_ms": 1, "threshold_jitter_mV": 1.0, "release_u": 0.25, "recovery_ms": 150, "facilitation_ms": 0},
    "medium_spiny":          {"v_rest_mV": -72, "v_reset_mV": -65, "v_threshold_mV": -50, "delta_t_mV": 2.0, "v_peak_mV": -30, "tau_m_ms": 15, "a": 0.05, "b_mV": 1.0, "tau_w_ms": 200, "refractory_ms": 2, "threshold_jitter_mV": 1.5, "release_u": 0.2,  "recovery_ms": 200, "facilitation_ms": 350},
    "vip_disinhibitory": {"v_rest_mV": -65, "v_reset_mV": -60, "v_threshold_mV": -55, "delta_t_mV": 2.0, "v_peak_mV": -30, "tau_m_ms": 18, "a": 0.02, "b_mV": 0.5, "tau_w_ms": 150, "refractory_ms": 1.5, "threshold_jitter_mV": 1.0, "release_u": 0.1, "recovery_ms": 800, "facilitation_ms": 400},
    "pacemaker":    {"v_rest_mV": -52, "v_reset_mV": -58, "v_threshold_mV": -50, "delta_t_mV": 2.0, "v_peak_mV": -30, "tau_m_ms": 30, "a": 0.0,  "b_mV": 6.0, "tau_w_ms": 600, "refractory_ms": 3, "threshold_jitter_mV": 1.5, "release_u": 0.3,  "recovery_ms": 300, "facilitation_ms": 0}
  },

  "synapses": {
    "glutamate_reversal_mV": 0,
    "gaba_a_reversal_mV": -75,
    "gaba_b_reversal_mV": -90,
    "ampa_decay_ms": 5,
    "nmda_decay_ms": 100,
    "nmda_to_ampa_ratio": 0.08,
    "magnesium_mM": 1.0,
    "gaba_a_decay_ms": 8,
    "gaba_b_decay_ms": 150,
    "gaba_b_to_a_ratio": 0.03,
    "local_delay_ms": 1,
    "long_range_delay_ms": 5,
    "weights": {"glutamate_onto_projection": 0.12, "glutamate_onto_interneuron": 0.2, "gaba_onto_projection": 0.24, "gaba_onto_interneuron": 0.2, "gaba_projection_collateral_scale": 0.3, "jitter": 0.3},
    "local_in_degree": {"projection_from_projection": 30, "projection_from_interneuron": 12, "interneuron_from_projection": 30, "interneuron_from_interneuron": 8},
    "long_range_in_degree_per_weight": 90,
    "feedforward_interneuron_fraction": 0.25
  },

  "background_input": {
    "rate_hz": 2000,
    "interneuron_scale": 0.7,
    "weight": 0.03,
    "description": "Poisson excitatory input standing in for the many brain areas that are not modeled."
  },

  "regions": [
    {"id": "sensory_thalamus", "label": "Sensory thalamus", "role": "Relays sights, sounds, touch and pain; the first stop for the sensory channels.", "relative_size": 1.0, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "sensory_cortex", "label": "Sensory cortex", "role": "Detailed perception; sends the slower 'high road' to the amygdala.", "relative_size": 1.6, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true, "vip_fraction": 0.12, "sst_fraction": 0.45},
    {"id": "insula", "label": "Insula", "role": "Interoceptive cortex: heartbeat, breathing, pain and touch from the body.", "relative_size": 1.0, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "amygdala_bla", "label": "Basolateral amygdala (threat cells)", "role": "Detects cues learned to predict danger; drives the central amygdala.", "relative_size": 0.6, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true, "vip_fraction": 0.08, "sst_fraction": 0.35},
    {"id": "amygdala_bla_reward", "label": "Basolateral amygdala (reward cells)", "role": "Detects cues learned to predict reward; drives the accumbens.", "relative_size": 0.4, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true, "vip_fraction": 0.1, "sst_fraction": 0.4},
    {"id": "amygdala_cea", "label": "Central amygdala", "role": "GABAergic output that triggers defensive, autonomic and arousal responses.", "relative_size": 0.5, "projection_fraction": 0.9, "transmitter": "gaba", "projection_cell_type": "regular_spiking", "fast_output": true, "background_scale": 0.55, "local_in_degree": {"projection_from_interneuron": 4}},
    {"id": "bnst", "label": "Bed nucleus of the stria terminalis", "role": "Sustained, uncertain-threat (anxiety-like) responses.", "relative_size": 0.4, "projection_fraction": 0.9, "transmitter": "gaba", "projection_cell_type": "regular_spiking", "fast_output": true, "local_in_degree": {"projection_from_interneuron": 4}},
    {"id": "hippocampus", "label": "Hippocampus", "role": "Context, memory and novelty detection.", "relative_size": 1.2, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true, "vip_fraction": 0.1, "sst_fraction": 0.4},
    {"id": "vmpfc", "label": "Ventromedial prefrontal cortex", "role": "Value, safety and regulation of the amygdala.", "relative_size": 1.2, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "dacc", "label": "Dorsal anterior cingulate", "role": "Conflict, effort, social pain and uncertainty.", "relative_size": 1.0, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "dlpfc", "label": "Dorsolateral prefrontal cortex", "role": "Goal control and reappraisal.", "relative_size": 1.2, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "nucleus_accumbens", "label": "Nucleus accumbens", "role": "Reward and motivation; its GABAergic medium spiny neurons are driven by dopamine.", "relative_size": 0.9, "projection_fraction": 0.95, "transmitter": "gaba", "projection_cell_type": "medium_spiny", "fast_output": true, "local_in_degree": {"projection_from_interneuron": 6}, "background_scale": 1.2},
    {"id": "lateral_habenula", "label": "Lateral habenula", "role": "Signals disappointment and loss; suppresses dopamine and serotonin cells.", "relative_size": 0.25, "projection_fraction": 0.85, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "hypothalamus", "label": "Hypothalamus", "role": "Stress hormones, autonomic control, hunger.", "relative_size": 0.6, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "oxytocin_pvn", "label": "Oxytocin cells (PVN/SON)", "role": "Release oxytocin during warm social contact.", "relative_size": 0.25, "projection_fraction": 0.85, "transmitter": "glutamate", "projection_cell_type": "pacemaker", "fast_output": false, "background_scale": 0.6},
    {"id": "pag", "label": "Periaqueductal gray", "role": "Defensive behavior (freeze, flight, fight) and pain control.", "relative_size": 0.5, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true},
    {"id": "vta", "label": "Ventral tegmental area", "role": "Dopamine source.", "relative_size": 0.3, "projection_fraction": 0.7, "transmitter": "glutamate", "projection_cell_type": "pacemaker", "fast_output": false, "background_scale": 0.9},
    {"id": "locus_coeruleus", "label": "Locus coeruleus", "role": "Noradrenaline source; arousal and vigilance.", "relative_size": 0.2, "projection_fraction": 0.85, "transmitter": "glutamate", "projection_cell_type": "pacemaker", "fast_output": false, "background_scale": 0.6},
    {"id": "raphe", "label": "Dorsal raphe", "role": "Serotonin source.", "relative_size": 0.25, "projection_fraction": 0.7, "transmitter": "glutamate", "projection_cell_type": "pacemaker", "fast_output": false, "background_scale": 0.6},
    {"id": "basal_forebrain", "label": "Basal forebrain", "role": "Acetylcholine source; attention to new things.", "relative_size": 0.3, "projection_fraction": 0.7, "transmitter": "glutamate", "projection_cell_type": "pacemaker", "fast_output": false, "background_scale": 0.75},
    {"id": "motor_brainstem", "label": "Brainstem autonomic and motor output", "role": "Heart rate, breathing, startle and posture; feeds bodily signals back to the insula.", "relative_size": 0.5, "projection_fraction": 0.8, "transmitter": "glutamate", "projection_cell_type": "regular_spiking", "fast_output": true}
  ],

  "projections_note": "weight sets how many synapses each target cell receives (in-degree = weight x long_range_in_degree_per_weight). A glutamatergic source excites target projection cells (plus some feedforward interneurons); a negative weight means it drives the target's interneurons instead (feedforward inhibition). A GABAergic source inhibits target projection cells, or with target 'interneurons' inhibits the local interneurons (disinhibition).",
  "projections": [
    {"from": "sensory_thalamus", "to": "sensory_cortex", "weight": 0.6},
    {"from": "sensory_thalamus", "to": "amygdala_bla", "weight": 0.35, "plastic_synapse": true, "note": "low road - LEARNED threat association"},
    {"from": "sensory_thalamus", "to": "insula", "weight": 0.2},
    {"from": "sensory_thalamus", "to": "amygdala_bla_reward", "weight": 0.2, "plastic_synapse": true, "note": "LEARNED reward association"},
    {"from": "sensory_cortex", "to": "amygdala_bla", "weight": 0.45, "plastic_synapse": true, "note": "high road - LEARNED threat association"},
    {"from": "sensory_cortex", "to": "hippocampus", "weight": 0.35},
    {"from": "sensory_cortex", "to": "amygdala_bla_reward", "weight": 0.3, "plastic_synapse": true, "note": "LEARNED reward association"},
    {"from": "sensory_cortex", "to": "dacc", "weight": 0.15},
    {"from": "sensory_cortex", "to": "sensory_thalamus", "weight": 0.25, "note": "corticothalamic feedback"},
    {"from": "insula", "to": "amygdala_bla", "weight": 0.25},
    {"from": "insula", "to": "amygdala_cea", "weight": 0.15},
    {"from": "insula", "to": "dacc", "weight": 0.3},
    {"from": "insula", "to": "hypothalamus", "weight": 0.2},
    {"from": "insula", "to": "oxytocin_pvn", "weight": 0.15},
    {"from": "amygdala_bla", "to": "amygdala_cea", "weight": 0.5},
    {"from": "amygdala_bla", "to": "bnst", "weight": 0.3},
    {"from": "amygdala_bla", "to": "nucleus_accumbens", "weight": 0.1},
    {"from": "amygdala_bla", "to": "amygdala_bla_reward", "weight": -0.2, "note": "valence populations inhibit each other"},
    {"from": "amygdala_bla_reward", "to": "nucleus_accumbens", "weight": 0.45, "note": "positive-valence route (Namburi et al. 2015)"},
    {"from": "amygdala_bla_reward", "to": "vmpfc", "weight": 0.15},
    {"from": "amygdala_bla_reward", "to": "amygdala_bla", "weight": -0.2},
    {"from": "amygdala_bla", "to": "vmpfc", "weight": 0.1},
    {"from": "amygdala_bla", "to": "dacc", "weight": 0.2},
    {"from": "amygdala_bla", "to": "hippocampus", "weight": 0.1},
    {"from": "amygdala_cea", "to": "pag", "weight": 0.9, "target": "interneurons", "note": "disinhibits PAG output"},
    {"from": "amygdala_cea", "to": "hypothalamus", "weight": 0.8, "target": "interneurons"},
    {"from": "amygdala_cea", "to": "locus_coeruleus", "weight": 0.8, "target": "interneurons", "note": "stands in for CRF drive of LC"},
    {"from": "amygdala_cea", "to": "motor_brainstem", "weight": 0.6, "target": "interneurons"},
    {"from": "amygdala_cea", "to": "basal_forebrain", "weight": 0.15, "target": "interneurons"},
    {"from": "bnst", "to": "hypothalamus", "weight": 0.35, "target": "interneurons"},
    {"from": "bnst", "to": "pag", "weight": 0.2, "target": "interneurons"},
    {"from": "hippocampus", "to": "vmpfc", "weight": 0.35},
    {"from": "hippocampus", "to": "nucleus_accumbens", "weight": 0.3},
    {"from": "hippocampus", "to": "amygdala_bla", "weight": 0.15},
    {"from": "hippocampus", "to": "amygdala_bla_reward", "weight": 0.1},
    {"from": "hippocampus", "to": "bnst", "weight": 0.15},
    {"from": "hippocampus", "to": "hypothalamus", "weight": -0.1, "note": "ventral hippocampus restrains the stress axis"},
    {"from": "hippocampus", "to": "vta", "weight": 0.1, "note": "novelty loop via accumbens and pallidum"},
    {"from": "vmpfc", "to": "amygdala_cea", "weight": -0.4, "note": "via intercalated cells"},
    {"from": "vmpfc", "to": "amygdala_bla", "weight": -0.2},
    {"from": "vmpfc", "to": "nucleus_accumbens", "weight": 0.25},
    {"from": "vmpfc", "to": "hypothalamus", "weight": -0.15},
    {"from": "vmpfc", "to": "pag", "weight": -0.15},
    {"from": "vmpfc", "to": "raphe", "weight": 0.15},
    {"from": "vmpfc", "to": "vta", "weight": 0.1},
    {"from": "vmpfc", "to": "oxytocin_pvn", "weight": 0.1},
    {"from": "dacc", "to": "dlpfc", "weight": 0.3},
    {"from": "dacc", "to": "amygdala_bla", "weight": 0.15},
    {"from": "dacc", "to": "locus_coeruleus", "weight": 0.25},
    {"from": "dacc", "to": "pag", "weight": 0.1},
    {"from": "dacc", "to": "vmpfc", "weight": 0.1},
    {"from": "dlpfc", "to": "dacc", "weight": -0.2},
    {"from": "dlpfc", "to": "vmpfc", "weight": 0.25, "note": "reappraisal route"},
    {"from": "dlpfc", "to": "sensory_cortex", "weight": 0.15, "note": "top-down attention"},
    {"from": "dlpfc", "to": "nucleus_accumbens", "weight": 0.1},
    {"from": "nucleus_accumbens", "to": "vta", "weight": 0.3, "target": "interneurons", "note": "D1 cells disinhibit dopamine cells"},
    {"from": "nucleus_accumbens", "to": "hypothalamus", "weight": 0.2},
    {"from": "lateral_habenula", "to": "vta", "weight": -0.5, "note": "via RMTg GABA cells"},
    {"from": "lateral_habenula", "to": "raphe", "weight": -0.35},
    {"from": "hypothalamus", "to": "pag", "weight": 0.3},
    {"from": "hypothalamus", "to": "locus_coeruleus", "weight": 0.2},
    {"from": "hypothalamus", "to": "motor_brainstem", "weight": 0.35},
    {"from": "hypothalamus", "to": "vta", "weight": 0.15, "note": "orexin/feeding drive"},
    {"from": "hypothalamus", "to": "lateral_habenula", "weight": 0.15},
    {"from": "hypothalamus", "to": "basal_forebrain", "weight": 0.1},
    {"from": "pag", "to": "motor_brainstem", "weight": 0.45},
    {"from": "pag", "to": "locus_coeruleus", "weight": 0.15},
    {"from": "pag", "to": "hypothalamus", "weight": 0.1},
    {"from": "pag", "to": "raphe", "weight": 0.1},
    {"from": "motor_brainstem", "to": "insula", "weight": 0.12, "note": "visceral feedback via NTS/parabrachial"},
    {"from": "motor_brainstem", "to": "locus_coeruleus", "weight": 0.2, "note": "visceral feedback via NTS"}
  ],

  "neuromodulation": {
    "receptor_half_occupancy": 1.0,
    "excitability_mV_per_occupancy": 12.0,
    "gain_per_occupancy": 2.0,
    "note": "Each chemical's level in a region relaxes toward (source firing x projection density) and is cleared with the given time constant. Effects act on the change in receptor occupancy from its resting value: excitability shifts membrane drive, adaptation scales spike-frequency adaptation, nmda scales NMDA conductance."
  },
  "neuromodulators": [
    {"name": "dopamine", "source": "vta", "clearance_ms": 400, "resting_source_hz": 3.2,
     "targets": {"nucleus_accumbens": 1.0, "vmpfc": 0.35, "dacc": 0.3, "dlpfc": 0.3, "amygdala_bla": 0.4, "amygdala_bla_reward": 0.5, "hippocampus": 0.2, "bnst": 0.3, "vta": 0.5},
     "effects": {"nucleus_accumbens": {"excitability": 0.35, "nmda": 0.4}, "vmpfc": {"excitability": 0.1, "nmda": 0.3}, "dlpfc": {"excitability": 0.05, "nmda": 0.4}, "dacc": {"excitability": 0.1}, "amygdala_bla": {"excitability": 0.15}, "amygdala_bla_reward": {"excitability": 0.2}, "hippocampus": {"excitability": 0.1}, "bnst": {"excitability": 0.1}, "vta": {"excitability": -0.5}}},
